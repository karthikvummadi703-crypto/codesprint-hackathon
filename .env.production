VITE_FIREBASE_AUTH_DOMAIN=codesprint-hackathon.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=codesprint-hackathon
VITE_FIREBASE_STORAGE_BUCKET=codesprint-hackathon.firebasestorage.app
