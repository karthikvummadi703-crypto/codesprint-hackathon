# Firebase web app credentials (safe to ship; access is controlled by the
# Firestore/Storage rules and by Firebase Auth).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend origin. Only needed to override the default, which is
# http://localhost:8001 in dev and the deployed Railway URL in production.
# Set this explicitly if you deploy the API somewhere else.
# VITE_API_BASE_URL=
