# Firebase Admin (optional for local dev — skip and the server runs in dev/mock mode)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LLM provider (OpenAI-compatible chat completions). Base URL defaults to OpenAI.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Air quality APIs. Google Air Quality API is preferred, then OpenWeatherMap. Mock fallback used if both absent.
GOOGLE_AQ_API_KEY=
AIR_QUALITY_API_KEY=
OPENWEATHER_APPID=

ALLOWED_ORIGINS=http://localhost:5173
