# ---------------------------------------------------------------------------
# AirGuard AI backend configuration
# Copy to `.env` and fill in only what you have. Every value here is optional:
# with none of them set the server still runs on the keyless providers
# (Open-Meteo air quality + weather, Nominatim geocoding) and reports
# `degraded: true` for AI chat. Nothing below is ever logged.
# ---------------------------------------------------------------------------

# "production" enables strict auth (no dev: tokens) and pins the deployed origins.
ENVIRONMENT=development

# Comma-separated extra origins. In production, loopback entries are dropped and
# the deployed Firebase origins are always added, so a stale localhost-only value
# here cannot take the live app offline.
ALLOWED_ORIGINS=http://localhost:5173

# Local convenience only. Forced off when ENVIRONMENT=production.
ALLOW_DEV_AUTH=true


# --- Firebase Admin (required for real user auth and per-user RAG/records) ---
# In production all three are mandatory; missing them is a startup error.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes in one line, or use a real multiline quoted value.
FIREBASE_PRIVATE_KEY=


# --- LLM provider (any OpenAI-compatible chat completions endpoint) ----------
# Comma-separated, tried in order. Free-tier endpoints get rate-limited
# independently, so a second model keeps the assistant answering instead of
# dropping to the grounded fallback when the first one returns 429.
# Order by measured latency, fastest first: a large model that answers in 12s
# makes the chat feel broken even though it is working. The chain already skips
# ahead on a 429, so put the quick model first and the big one last as a
# quality fallback.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODELS=
# Reasoning budget for reasoning models (e.g. "low"/"medium"/"high"). Leave empty
# for providers that reject unknown body fields. It is not only a speed knob: left
# unset, a reasoning model over-applies the "ground everything in CONTEXT" rule
# and refuses ordinary questions.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_S=20
# Ceiling on the whole chain, not one model. Keeps a long failover from turning
# into a wait the user reads as a broken chat, so the grounded answer wins the
# race instead of the request hanging.
LLM_TOTAL_BUDGET_S=18
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.6


# --- Air quality providers -------------------------------------------------
# Open-Meteo CAMS needs no key and is always used, so a reading is always
# available. These two are preferred when present; AIR_QUALITY_API_KEY is
# accepted as an alias for OPENWEATHER_APPID.
GOOGLE_AQ_API_KEY=
OPENWEATHER_APPID=
AIR_QUALITY_API_KEY=

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_BASE_URL=https://air-quality-api.open-meteo.com/v1


# --- Geocoding -------------------------------------------------------------
# Nominatim's usage policy requires a real identifying User-Agent.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AirGuard-AI/2.0 (environmental-intelligence)


# --- Shared HTTP client ----------------------------------------------------
HTTP_TIMEOUT_S=10
HTTP_MAX_RETRIES=2


# --- Cache (seconds) -------------------------------------------------------
CACHE_TTL_AQI_S=600
CACHE_TTL_WEATHER_S=900
CACHE_TTL_GEOCODE_S=86400
CACHE_MAX_ENTRIES=512


# --- Rate limiting ---------------------------------------------------------
# Per-user, keyed on the authenticated uid. Chat is limited more tightly.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_CHAT_REQUESTS=15
RATE_LIMIT_CHAT_WINDOW_S=300


# --- Misc ------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
